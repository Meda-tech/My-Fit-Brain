{
  "name": "mfb-assessments",
  "private": true,
  "description": "MFB Assessments monorepo: clients/ and admin/ Next.js apps plus shared packages/",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "clients",
    "admin",
    "packages/*"
  ],
  "scripts": {
    "dev:clients": "npm run dev -w clients",
    "dev:admin": "npm run dev -w admin",
    "build": "npm run build -w clients && npm run build -w admin",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "qb:import": "npm run qb:import -w @mfb/questionbank --",
    "qb:patch": "npm run qb:patch -w @mfb/questionbank --"
  }
}
