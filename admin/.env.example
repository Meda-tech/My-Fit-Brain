# -------------------------------------------------------------
# My Fit Brain — MFB Assessments staff portal (admin/)
# Production: https://admin.myfitbrain.app · Local dev port: 3001
# Copy to .env.local and fill in. Never commit real keys.
# -------------------------------------------------------------

# Supabase API (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Privileged service role key (SERVER-SIDE ONLY — never expose to the browser).
# Lets the super admin provision coordinator and counsellor accounts (supabase.auth.admin).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs (read by lib/site.ts and next.config.ts). No trailing slash.
# Local:
NEXT_PUBLIC_CLIENTS_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Production:
# NEXT_PUBLIC_CLIENTS_URL=https://app.myfitbrain.app
# NEXT_PUBLIC_ADMIN_URL=https://admin.myfitbrain.app

# The first super admin is created by the owner directly in Supabase (see SUPABASE_SETUP_GUIDE.md).
# There is no bootstrap page or API, so no bootstrap email variable is needed.
