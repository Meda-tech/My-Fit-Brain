# -------------------------------------------------------------
# My Fit Brain — MFB Assessments client portal (clients/)
# Production: https://app.myfitbrain.app · Local dev port: 3000
# Copy to .env.local and fill in. Never commit real keys.
# -------------------------------------------------------------

# Supabase API (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Privileged service role key (SERVER-SIDE ONLY — never expose to the browser).
# Used to link a staff pre-created client record after phone OTP verification.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URLs (read by lib/site.ts and next.config.ts). No trailing slash.
# Local:
NEXT_PUBLIC_CLIENTS_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
# Production:
# NEXT_PUBLIC_CLIENTS_URL=https://app.myfitbrain.app
# NEXT_PUBLIC_ADMIN_URL=https://admin.myfitbrain.app

# Razorpay (Dashboard -> Account & Settings -> API Keys). SERVER-SIDE ONLY: never NEXT_PUBLIC_.
# Test mode keys start with rzp_test_, live keys with rzp_live_. The code is the same for both.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-key-secret
# Dashboard -> Webhooks -> Add new webhook:
#   URL     https://app.myfitbrain.app/api/payments/webhook
#   Secret  any long random string, same value here
#   Events  payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret
